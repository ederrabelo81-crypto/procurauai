# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL / anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Observabilidade (opcional) ──────────────────────────────────────────────
VITE_SENTRY_DSN=

# ── Ambiente: development | staging | production ────────────────────────────
VITE_ENVIRONMENT=development

# ── Google Maps ─────────────────────────────────────────────────────────────
# Console: https://console.cloud.google.com/google/maps-apis
# APIs necessárias: Maps JavaScript API, Maps Embed API, Maps Static API.
# Restrinja a chave por referenciador HTTP (localhost e domínio de produção).
# Passo a passo completo em docs/google-maps.md
VITE_GOOGLE_MAPS_API_KEY=

# Map ID criado em Map Management (habilita AdvancedMarker e estilo na nuvem).
# Sem valor, o app usa DEMO_MAP_ID (funciona, mas com marca d'água).
VITE_GOOGLE_MAPS_MAP_ID=
